# Copy sang .env, điền IP LAN thật của máy chạy backend (KHÔNG dùng localhost — điện thoại thật
# không tự resolve được localhost của máy dev). Xem IP bằng `ipconfig getifaddr en0` (macOS Wi-Fi).
# Đổi lại mỗi khi máy dev đổi mạng/IP, và restart `npx expo start -c` sau khi sửa (biến EXPO_PUBLIC_*
# được bake vào bundle lúc build, không hot-reload).
EXPO_PUBLIC_API_URL="http://192.168.1.100:3000"

# Chỉ dùng cho Supabase Realtime (đọc bình luận trực tiếp từ client) — src/lib/supabase.ts.
# KHÔNG liên quan tới đăng nhập/OTP (OTP đi qua NestJS, không qua Supabase Auth).
# Lấy 2 giá trị này ở Supabase Dashboard → Project Settings → API Keys → mục "Publishable keys"
# (sb_publishable_..., bản thay thế "anon key" kiểu JWT cũ).
# KHÔNG dùng "Secret keys" (sb_secret_...) — key đó chỉ được nằm trong backend/.env.
EXPO_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
